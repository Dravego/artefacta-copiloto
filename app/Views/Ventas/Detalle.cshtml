@model Venta
@{
    ViewData["Title"] = $"Venta {Model.Folio}";
}
<h1>Venta @Model.Folio</h1>
<div class="panel">
    <p><strong>Cliente:</strong> @Model.Cliente.Nombre</p>
    <p><strong>Vendedor:</strong> @Model.Vendedor?.Nombre</p>
    <p><strong>Fecha:</strong> @Model.FechaVenta.ToString("dd/MM/yyyy HH:mm")</p>
    <p><strong>Estatus:</strong> @Model.Estatus</p>
    <p><strong>Total:</strong> @Model.Total.ToString("C2")</p>
</div>
<table>
<thead><tr><th>Producto</th><th>Cantidad</th><th>Precio</th><th>Descuento</th><th>Importe</th></tr></thead>
<tbody>
@foreach (var d in Model.Detalles)
{
<tr><td>@d.Producto.Nombre</td><td>@d.Cantidad</td><td>@d.PrecioUnitario.ToString("C2")</td><td>@d.Descuento.ToString("C2")</td><td>@d.Importe.ToString("C2")</td></tr>
}
</tbody>
</table>
