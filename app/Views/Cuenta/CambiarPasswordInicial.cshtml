@model Artefacta.Copiloto.ViewModels.CambioPasswordInicialViewModel
@{
    Layout = null;
    ViewData["Title"] = "Definir contraseña";
    var returnUrl = ViewBag.ReturnUrl as string;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Definir contraseña - ARTEFACTA Copiloto</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="auth-page">
<div class="auth-card">
    <div class="auth-brand">ARTEFACTA COPILOTO</div>
    <h1>Define tu contraseña</h1>
    <p>
        El usuario <strong>@Model.Username</strong> tiene una contraseña pendiente
        de reemplazo. Debes establecer una nueva antes de iniciar sesión.
    </p>

    <div class="password-reset-note">
        La nueva contraseña debe tener al menos 10 caracteres.
    </div>

    <form asp-action="CambiarPasswordInicial"
          asp-route-returnUrl="@returnUrl"
          method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Username" />

        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <label asp-for="NuevaPassword"></label>
        <input asp-for="NuevaPassword"
               autocomplete="new-password"
               autofocus />

        <span asp-validation-for="NuevaPassword" class="validation"></span>

        <label asp-for="ConfirmarPassword"></label>
        <input asp-for="ConfirmarPassword"
               autocomplete="new-password" />

        <span asp-validation-for="ConfirmarPassword" class="validation"></span>

        <button class="auth-submit" type="submit">
            Guardar nueva contraseña
        </button>
    </form>

    <p class="auth-back">
        <a asp-action="Login">Volver al login</a>
    </p>
</div>
</body>
</html>
