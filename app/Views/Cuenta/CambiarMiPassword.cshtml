@model Artefacta.Copiloto.ViewModels.CambiarMiPasswordViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}
<div class="panel user-form-panel">
    <span class="eyebrow">Mi cuenta</span>
    <h1>Cambiar contraseña</h1>

    <form asp-action="CambiarMiPassword" method="post" class="admin-form">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <label asp-for="PasswordActual"></label>
        <input asp-for="PasswordActual" autocomplete="current-password" />

        <label asp-for="NuevaPassword"></label>
        <input asp-for="NuevaPassword" autocomplete="new-password" />

        <label asp-for="ConfirmarPassword"></label>
        <input asp-for="ConfirmarPassword" autocomplete="new-password" />

        <div class="form-actions">
            <button type="submit">Actualizar contraseña</button>
            <a class="button secondary" asp-controller="Home" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>
